        {"column": "start_date", "type": "date"},
        {
          "column": "level",
          "type": "enum",
          "allowed": ["beginner", "intermediate", "advanced"]
        }
      ]
    },
    {
      "file": "sessions.csv",
      "required": true,
      "minimum_rows": 1,
      "required_columns": ["session_id", "course_id", "room", "seats"],
      "non_empty_columns": ["session_id", "course_id", "room"],
      "unique_keys": [["session_id"]],
      "field_rules": [
        {"column": "seats", "type": "number"}
      ]
    }
  ],
  "references": [
    {
      "source_file": "sessions.csv",
